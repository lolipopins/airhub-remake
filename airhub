        if not slot then return end
        text = text or ""
        -- пробуем все известные API библиотеки, чтобы точно затереть значение
        if type(slot.Set) == "function" then
            pcall(function() slot:Set(text) end)
        end
        if type(slot.SetValue) == "function" then
            pcall(function() slot:SetValue(text) end)
        end
        if type(slot.SetText) == "function" then
            pcall(function() slot:SetText(text) end)
        end
        pcall(function() slot.Value = text end)
        pcall(function() slot.Text = text end)
    end

    local function UpdateConfigListUI()
        -- 1) принудительно чистим ВСЕ слоты
        for i = 1, LIST_SLOTS do
            SetSlotText(listSlots[i], "")
        end

        -- 2) заново получаем актуальный список файлов
        local list = Config_ListFiles()
        local total = #list

        -- 3) заполняем
        for i = 1, LIST_SLOTS do
            local text = ""
            if i < LIST_SLOTS then
                if i <= total then text = list[i] end
            else -- последний слот
                if total > LIST_SLOTS then
                    text = "... +" .. (total - LIST_SLOTS + 1) .. " more"
                elseif i <= total then
                    text = list[i]
                end
            end
            SetSlotText(listSlots[i], text)
        end

        if total == 0 then
            SetSlotText(listSlots[1], "(no configs)")
        end

        warn("[AirHub] Configs (" .. total .. "): " .. (total > 0 and table.concat(list, ", ") or "none"))
        return list
    end

    -- 4) Кнопки
    cfgSec:AddButton({ Name = "Save Config", Callback = function()
        if not currentConfigName or currentConfigName == "" then
            warn("[AirHub] Enter config name"); ShowError("Enter config name"); return
        end
        local ok, where = Config_Save(currentConfigName)
        if ok then
            warn("[AirHub] Config saved (" .. tostring(where) .. "): " .. currentConfigName)
            ShowError("Saved: " .. currentConfigName .. " (" .. tostring(where) .. ")")
            UpdateConfigListUI()
        else
            warn("[AirHub] Save failed: " .. tostring(where))
            ShowError("Save failed: " .. tostring(where))
        end
    end })

    cfgSec:AddButton({ Name = "Load Config", Callback = function()
        if not currentConfigName or currentConfigName == "" then
            warn("[AirHub] Enter config name"); ShowError("Enter config name"); return
        end
        local ok, where = Config_Load(currentConfigName)
        if ok then
            warn("[AirHub] Config loaded (" .. tostring(where) .. "): " .. currentConfigName)
            ShowError("Loaded: " .. currentConfigName)
        else
            warn("[AirHub] Load failed: " .. tostring(where))
            ShowError("Load failed: " .. tostring(where))
        end
    end })

    cfgSec:AddButton({ Name = "Delete Config", Callback = function()
        if not currentConfigName or currentConfigName == "" then
            warn("[AirHub] Enter config name"); ShowError("Enter config name"); return
        end

        local nameToDelete = currentConfigName
        local ok, where = Config_Delete(nameToDelete)

        if ok then
            warn("[AirHub] Deleted: " .. nameToDelete)
            ShowError("Deleted: " .. nameToDelete)

            -- очищаем поле имени
            currentConfigName = ""
            if cfgNameBox and type(cfgNameBox.Set) == "function" then
                pcall(function() cfgNameBox:Set("") end)
            elseif cfgNameBox and type(cfgNameBox.SetValue) == "function" then
                pcall(function() cfgNameBox:SetValue("") end)
            end

            -- обновляем список в UI (с небольшой задержкой, чтобы FS успела удалить)
            task.defer(UpdateConfigListUI)
        else
            warn("[AirHub] Delete failed: " .. tostring(where))
            ShowError("Delete failed: " .. tostring(where))
        end
    end })

    cfgSec:AddButton({ Name = "Refresh List", Callback = function()
        local list = UpdateConfigListUI()
        ShowError("Found: " .. tostring(#list) .. " (введи № в Select #)")
    end })

    -- Main
    local mainSec = SettingsTab:CreateSection({ Name = "Main" })

    mainSec:AddButton({ Name = "Reset All", Callback = function()
        Aimbot.Settings = { Enabled = false, TeamCheck = {Enabled = true, Mode = "Enemies", TreatNeutralAsEnemy = true}, AliveCheck = true, WallCheck = false, FallbackToVisible = false, AimSmoothingSpeed = 6, TriggerKey = "MouseButton2", Toggle = false, LockPart = "Head", AimMethod = "Smooth", SilentAim = true, SilentAimMode = "Camera", IgnoreFOV = false, CheckFromPlayerOnTP = true, AutoShoot = {Enabled = false, ShootKey = "MouseButton1", FireRate = 0.05, OnlyWhenAiming = true, AutoStop = {Enabled = false, Time = 0.1}} }
        Aimbot.FOVSettings = {Enabled = true, Visible = true, Amount = 90}
        WallHack.Functions.ResetSettings()
        AntiAim.Functions.ResetSettings()
        ServerPosition.Settings = { Enabled = false, RGB = true, Strength = 1, MaxLimb = 6 }
        StopServerPosition()
        Fly.Functions.ResetSettings()
        Bhop.Functions.ResetSettings()
        Speed.Functions.ResetSettings()
        AutoStrafer.Functions.ResetSettings()
        Noclip.Functions.ResetSettings()
        getgenv().AirHub.Logging = {Enabled = true, ShowHit = true, ShowMiss = true, Duration = 1, FontSize = 18}
        getgenv().AirHub.Sound = { HitsoundEnabled = false, HitsoundID = 83717596220569, HitsoundVolume = 1, KillsoundEnabled = false, KillsoundID = 83717596220569, KillsoundVolume = 1 }
        if Library.ResetAll then Library.ResetAll() end
        ApplyGlowToAll()
        ShowError("All settings reset")
    end })

    mainSec:AddButton({ Name = "Rejoin", Callback = Rejoin })
    mainSec:AddButton({ Name = "Server Hop", Callback = ServerHop })
    mainSec:AddButton({ Name = "Exit (Unload All)", Callback = function()
        Library:Unload()
    end })

    task.defer(UpdateConfigListUI)

    ShowError("Airhub loaded")
end)
