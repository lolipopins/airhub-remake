local CONFIG_FOLDER = "AirHub/Configs"
local IN_MEMORY_CONFIGS = {}

local function Config_HasFS()
    return type(writefile) == "function" and type(readfile) == "function"
end

pcall(function()
    if type(makefolder) == "function" then
        if type(isfolder) == "function" then
            if not isfolder("AirHub") then makefolder("AirHub") end
            if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
        else
            pcall(makefolder, "AirHub")
            pcall(makefolder, CONFIG_FOLDER)
        end
    end
end)

local function Config_Encode(value)
    local t = type(value)
    if t == "number" or t == "string" or t == "boolean" then return value
    elseif t == "table" then
        if value.R ~= nil and value.G ~= nil and value.B ~= nil and value.X == nil then
            return {__t = "Color3", R = value.R, G = value.G, B = value.B}
        elseif value.X ~= nil and value.Y ~= nil and value.Z ~= nil and value.R == nil then
            return {__t = "Vector3", X = value.X, Y = value.Y, Z = value.Z}
        elseif value.X ~= nil and value.Y ~= nil and value.Z == nil then
            return {__t = "Vector2", X = value.X, Y = value.Y}
        else
            local out = {}
            for k, v in pairs(value) do
                local enc = Config_Encode(v)
                if enc ~= nil then out[k] = enc end
            end
            return out
        end
    end
    return nil
end

local function Config_Decode(value)
    if type(value) ~= "table" then return value end
    if value.__t == "Color3" then return Color3.new(value.R, value.G, value.B)
    elseif value.__t == "Vector3" then return Vector3.new(value.X, value.Y, value.Z)
    elseif value.__t == "Vector2" then return Vector2.new(value.X, value.Y)
    else
        local out = {}
        for k, v in pairs(value) do out[k] = Config_Decode(v) end
        return out
    end
end

local function Config_ListFiles()
    local list, seen = {}, {}
    for name in pairs(IN_MEMORY_CONFIGS) do
        if not seen[name] then seen[name] = true table.insert(list, name) end
    end
    if type(listfiles) == "function" then
        local ok, files = pcall(listfiles, CONFIG_FOLDER)
        if ok and type(files) == "table" then
            for _, path in ipairs(files) do
                local name = path:match("([^/\\]+)%.json$")
                if name and not seen[name] then
                    seen[name] = true table.insert(list, name)
                end
            end
        end
    end
    table.sort(list)
    return list
end

local function Config_Serialize()
    local H = getgenv().AirHub
    if not H then return {} end
    local data = {Version = 1}
    if H.Aimbot then data.Aimbot = H.Aimbot.Settings data.FOVSettings = H.Aimbot.FOVSettings end
    if H.WallHack then
        data.WallHack = H.WallHack.Settings
        data.BoxSettings = H.WallHack.Visuals.BoxSettings
        data.GlowSettings = H.WallHack.Visuals.GlowSettings
    end
    if H.AntiAim then data.AntiAim = H.AntiAim.Settings data.Desync = H.AntiAim.Desync.Settings end
    if H.ServerPosition then data.ServerPosition = H.ServerPosition.Settings end
    if H.Fly then data.Fly = H.Fly.Settings end
    if H.Bhop then data.Bhop = H.Bhop.Settings end
    if H.Speed then data.Speed = H.Speed.Settings end
    if H.AutoStrafer then data.AutoStrafer = H.AutoStrafer.Settings end
    if H.Noclip then data.Noclip = H.Noclip.Settings end
    data.Logging = H.Logging
    data.Sound   = H.Sound
    return data
end

local function Config_Apply(data)
    if type(data) ~= "table" then return false end
    local H = getgenv().AirHub
    if not H then return false end
    if data.Aimbot and H.Aimbot then H.Aimbot.Settings = data.Aimbot end
    if data.FOVSettings and H.Aimbot then H.Aimbot.FOVSettings = data.FOVSettings end
    if data.WallHack and H.WallHack then H.WallHack.Settings = data.WallHack end
    if data.BoxSettings and H.WallHack then H.WallHack.Visuals.BoxSettings = data.BoxSettings end
    if data.GlowSettings and H.WallHack then H.WallHack.Visuals.GlowSettings = data.GlowSettings end
    if data.AntiAim and H.AntiAim then H.AntiAim.Settings = data.AntiAim end
    if data.Desync and H.AntiAim then H.AntiAim.Desync.Settings = data.Desync end
    if data.ServerPosition and H.ServerPosition then H.ServerPosition.Settings = data.ServerPosition end
    if data.Fly and H.Fly then H.Fly.Settings = data.Fly H.Fly.Internal.Active = false end
    if data.Bhop and H.Bhop then
        H.Bhop.Settings = data.Bhop
        H.Bhop.Internal.KeyHeld = false
        H.Bhop.Internal.Active = false
    end
    if data.Speed and H.Speed then H.Speed.Settings = data.Speed end
    if data.AutoStrafer and H.AutoStrafer then
        H.AutoStrafer.Settings = data.AutoStrafer
        H.AutoStrafer.Internal.Active = false
        H.AutoStrafer.Internal.KeyA = false
        H.AutoStrafer.Internal.KeyD = false
    end
    if data.Noclip and H.Noclip then H.Noclip.Settings = data.Noclip end
    if data.Logging then H.Logging = data.Logging end
    if data.Sound then H.Sound = data.Sound end
    return true
end

local function Config_Save(name)
    if not name or name == "" then return false, "empty name" end
    local data = Config_Serialize()
    if Config_HasFS() and type(HttpService.JSONEncode) == "function" then
        local ok, encoded = pcall(function()
            return HttpService:JSONEncode(Config_Encode(data))
        end)
        if ok and encoded then
            local path1 = CONFIG_FOLDER .. "/" .. name .. ".json"
            local path2 = CONFIG_FOLDER .. "\\" .. name .. ".json"
            local wok = pcall(writefile, path1, encoded)
            if not wok then wok = pcall(writefile, path2, encoded) end
            if wok then return true, "file" end
        else
            warn("[AirHub] Encode failed: " .. tostring(encoded))
        end
    end
    IN_MEMORY_CONFIGS[name] = data
    return true, "memory"
end

local function Config_Load(name)
    if not name or name == "" then return false, "empty name" end
    if IN_MEMORY_CONFIGS[name] then
        Config_Apply(IN_MEMORY_CONFIGS[name])
        return true, "memory"
    end
    if Config_HasFS() and type(readfile) == "function" then
        local content
        local ok1, c1 = pcall(readfile, CONFIG_FOLDER .. "/" .. name .. ".json")
        if ok1 and c1 and c1 ~= "" then content = c1
        else
            local ok2, c2 = pcall(readfile, CONFIG_FOLDER .. "\\" .. name .. ".json")
            if ok2 and c2 and c2 ~= "" then content = c2 end
        end
        if content then
            local decode_ok, decoded = pcall(function()
                return Config_Decode(HttpService:JSONDecode(content))
            end)
            if decode_ok and decoded then
                Config_Apply(decoded)
                return true, "file"
            else
                warn("[AirHub] Decode failed: " .. tostring(decoded))
            end
        end
    end
    return false, "not found"
end

local function Config_Delete(name)
    if not name or name == "" then return false, "empty name" end
    local deleted = false

    -- удаляем из памяти
    if IN_MEMORY_CONFIGS[name] then
        IN_MEMORY_CONFIGS[name] = nil
        deleted = true
    end

    -- удаляем файл(ы) — проверяем оба варианта пути
    if type(delfile) == "function" then
        local ok1 = pcall(delfile, CONFIG_FOLDER .. "/" .. name .. ".json")
        local ok2 = pcall(delfile, CONFIG_FOLDER .. "\\" .. name .. ".json")
        if ok1 or ok2 then deleted = true end
    end

    return deleted, deleted and "deleted" or "not found"
end

