local function UpdateCharacterTransparency()
    local char = LocalPlayer.Character
    if not char then return end
    local transparent = getgenv().AirHub.Character.Transparent
    local alpha = transparent and getgenv().AirHub.Character.Transparency or 0
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and not part:IsA("Tool") and part.Parent ~= nil and not part.Parent:IsA("Tool") then
            if not part.Parent:IsA("Accessory") then
                part.Transparency = alpha
            end
        end
    end
    for _, v in ipairs({"Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg","HumanoidRootPart"}) do
        local part = char:FindFirstChild(v)
        if part and part:IsA("BasePart") then
            part.Transparency = alpha
        end
    end
end

-- ESP шляпа (конус с полями)
local HatCone, HatBrim
local function UpdateHatESP()
    local settings = getgenv().AirHub.Character.HatESP
    if not settings.Enabled then
        if HatCone then HatCone:Remove() HatCone = nil end
        if HatBrim then HatBrim:Remove() HatBrim = nil end
        return
    end
    local char = LocalPlayer.Character
    if not char then
        if HatCone then HatCone.Visible = false end
        if HatBrim then HatBrim.Visible = false end
        return
    end
    local head = char:FindFirstChild("Head")
    if not head then
        if HatCone then HatCone.Visible = false end
        if HatBrim then HatBrim.Visible = false end
        return
    end

    local height = settings.Height
    local size = settings.Size
    local basePos = head.Position + Vector3.new(0, height, 0)
    local apexPos = head.Position + Vector3.new(0, height + size, 0)

    local baseScreen, onBase = Camera:WorldToViewportPoint(basePos)
    local apexScreen, onApex = Camera:WorldToViewportPoint(apexPos)
    local leftPos = basePos - Vector3.new(size * 0.6, 0, 0)
    local rightPos = basePos + Vector3.new(size * 0.6, 0, 0)
    local leftScreen, onLeft = Camera:WorldToViewportPoint(leftPos)
    local rightScreen, onRight = Camera:WorldToViewportPoint(rightPos)

    if not onBase or not onApex or not onLeft or not onRight then
        if HatCone then HatCone.Visible = false end
        if HatBrim then HatBrim.Visible = false end
        return
    end

    if not HatCone then
        HatCone = Drawing.new("Triangle")
        HatCone.Visible = true
        HatCone.Filled = true
    end
    if not HatBrim then
        HatBrim = Drawing.new("Line")
        HatBrim.Visible = true
        HatBrim.Thickness = 2
    end

    HatCone.PointA = Vector2.new(leftScreen.X, leftScreen.Y)
    HatCone.PointB = Vector2.new(rightScreen.X, rightScreen.Y)
    HatCone.PointC = Vector2.new(apexScreen.X, apexScreen.Y)
    HatCone.Color = settings.Color
    HatCone.Transparency = 0.3

    local brimOffset = 4
    HatBrim.From = Vector2.new(leftScreen.X, leftScreen.Y + brimOffset)
    HatBrim.To = Vector2.new(rightScreen.X, rightScreen.Y + brimOffset)
    HatBrim.Color = settings.Color
    HatBrim.Transparency = 0
end

RunService.RenderStepped:Connect(function()
    UpdateHatESP()
end)

