    if Typing then return end
    -- Кейбинд работает только если Fly уже включен (нельзя включить с клавиши)
    if not Fly.Settings.Enabled then return end
    if inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode == Enum.KeyCode[Fly.Settings.ToggleKey] then
        Fly.Settings.Enabled = false
        ShowError("Fly: OFF")
        RemoveFlyBody()
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end
    end
end)
