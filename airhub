local RayHookActive = false
local oldRayIndex = nil
local function GetClosestTargetRay()
    local target, dist = nil, math.huge
    local mousePos = Camera.ViewportSize / 2
    for _, player in next, Players:GetPlayers() do
        if player ~= LocalPlayer and player.Character and player:GetAttribute('Team') ~= LocalPlayer:GetAttribute('Team') then
            local head = player.Character:FindFirstChild('Head')
            local hum = player.Character:FindFirstChildOfClass('Humanoid')
            if head and hum and hum.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local headPos = Vector2.new(screenPos.X, screenPos.Y)
                    local mag = (mousePos - headPos).magnitude
                    if mag < dist then dist = mag target = head end
                end
            end
        end
    end
    return target
end

local function SetupRayHook()
    if RayHookActive then return end
    local success, mt = pcall(getrawmetatable, Ray.new())
    if not success or not mt then return end
    local old = mt.__index
    mt.__index = function(t, k)
        if k == 'Direction' and Aimbot.Settings.Enabled and Aimbot.Settings.SilentAim and Aimbot.Settings.SilentAimMode == "RayHook" and Running then
            local target = GetClosestTargetRay()
            if target then
                local origin = old(t, 'Origin')
                return (target.Position - origin).Unit
            end
        end
        return old(t, k)
    end
    oldRayIndex = old
    RayHookActive = true
end

local function RemoveRayHook()
    if not RayHookActive then return end
    local success, mt = pcall(getrawmetatable, Ray.new())
    if success and mt then mt.__index = oldRayIndex end
    RayHookActive = false
end

local MouseHitHooked = false
local originalGetMouse = nil
local function SetupMouseHitHook()
    if MouseHitHooked then return end
    originalGetMouse = LocalPlayer.GetMouse
    LocalPlayer.GetMouse = function()
        local realMouse = originalGetMouse(LocalPlayer)
        return setmetatable({}, {
            __index = function(t, k)
                if k == "Hit" then
                    if Aimbot.Settings.Enabled and Aimbot.Settings.SilentAim and Aimbot.Settings.SilentAimMode == "MouseHit" and Running and Aimbot.LockPartInstance then
                        return Aimbot.LockPartInstance.Position
                    end
                end
                return realMouse[k]
            end,
            __newindex = function(t, k, v) realMouse[k] = v end
        })
    end
    MouseHitHooked = true
end

local function RemoveMouseHitHook()
    if not MouseHitHooked then return end
    if originalGetMouse then LocalPlayer.GetMouse = originalGetMouse end
    MouseHitHooked = false
end

local function LoadAimbot()
