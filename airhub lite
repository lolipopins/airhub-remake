    if not s.HitsoundEnabled then return end
    if not Hitsound or Hitsound.SoundId ~= "rbxassetid://"..s.HitsoundID then
        if Hitsound then Hitsound:Destroy() end
        Hitsound = LoadSound(s.HitsoundID, s.HitsoundVolume)
