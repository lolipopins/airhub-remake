getgenv().AirHub.Noclip = { Settings = { Enabled = false }, Internal = { Active = false } }
local Noclip = getgenv().AirHub.Noclip
local function NoclipLoop()
    while task.wait(0.1) do
        if not Noclip.Settings.Enabled then
            if Noclip.Internal.Active then
                Noclip.Internal.Active = false
                local char = LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = true end
                    end
                end
            end
            continue
        end
        Noclip.Internal.Active = true
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end
end
coroutine.wrap(NoclipLoop)()
Noclip.Functions = {
