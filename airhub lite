local function ApplyAllEnabledStates()
    local H = getgenv().AirHub
    if not H then return end
    if WallHack.Settings.Enabled then ApplyGlowToAll() end
    if H.AntiAim and H.AntiAim.Desync.Settings.Enabled then
        StopDesync()
        task.defer(function()
            if getgenv().AirHub and getgenv().AirHub.AntiAim.Desync.Settings.Enabled then
                StartDesync()
            end
        end)
    else StopDesync() end
    if H.ServerPosition and H.ServerPosition.Settings.Enabled then
        StopServerPosition()
        task.defer(function()
            if getgenv().AirHub and getgenv().AirHub.ServerPosition.Settings.Enabled then
                StartServerPosition()
            end
        end)
    else StopServerPosition() end
    if H.Fly then
        Fly_ClearInstances()
        if H.Fly.Settings.Enabled and H.Fly.Settings.Toggle then
            H.Fly.Internal.Active = true
        else H.Fly.Internal.Active = false end
    end
    if H.Bhop then
        H.Bhop.Internal.KeyHeld = false
        H.Bhop.Internal.Active = false
        H.Bhop.Internal.SpiderTouching = false
    end
    if H.Speed then H.Speed.Internal.Active = false end
    if H.Noclip then H.Noclip.Internal.Active = false end
