            Position = UDim2.new(0, 0, 0.5, 0), Parent = track,
        })
        corner(knob, 6)
        local trackHit = new("TextButton", {
            Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20),
            Position = UDim2.new(0, 0, 0.5, -10), Parent = track,
        })
        local dragging = false
        local function fmt(v)
            if decimals <= 0 then return tostring(math.floor(v + 0.5)) end
            return string.format("%." .. decimals .. "f", v)
        end
        local function setVisual(v)
            local alpha = (max > min) and ((v - min) / (max - min)) or 0
            alpha = math.clamp(alpha, 0, 1)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, 0, 0.5, 0)
            valueLbl.Text = fmt(v)
        end
        local obj = { Value = value }
        local function apply(v, fire)
            v = math.clamp(tonumber(v) or min, min, max)
            if decimals <= 0 then v = math.floor(v + 0.5) end
            obj.Value = v
            setVisual(v)
            if fire then task.spawn(function() callback(v) end) end
        end
        local function fromInput(input)
            local pos = track.AbsolutePosition
            local size = track.AbsoluteSize
            if size.X <= 0 then return end
            local alpha = math.clamp((input.Position.X - pos.X) / size.X, 0, 1)
            apply(min + (max - min) * alpha, true)
        end
        trackHit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true fromInput(input)
            end
        end)
        trackHit.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                fromInput(input)
            end
        end)
        setVisual(value)
        function obj:Set(v) apply(v, true) end
        function obj:GetValue() return self.Value end
        table.insert(self.Controls, obj)
        return obj
    end

