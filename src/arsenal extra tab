--// ============================================================================
--// AirHub - 11_arsenal.lua
--// Extra tab "Arsenal" — ported from the Quotas Hub standalone script.
--//
--// Features:
--//   • Name Tags ESP    — player name above head with team/alive checks
--//   • Hitbox Expander  — "OP Silent Aim" style: enlarge enemy limbs client-side
--//   • Weapon Mods      — Infinite Ammo, Fire Rate, Recoil (ReplicatedStorage.Weapons)
--//
--// Requires: 01_core.lua, 07a_ui_core.lua
--// ============================================================================

local H = getgenv().AirHub
if not H or not H._CoreLoaded then warn("[AirHub] 11_arsenal: core not loaded") return end
if H.Arsenal and H.Arsenal._Loaded then return end

local Util               = H.Util
local Players            = Util.Players
local RunService         = Util.RunService
local LocalPlayer        = Util.LocalPlayer
local ReplicatedStorage  = Util.ReplicatedStorage
local Track              = Util.Track
local HandleError        = Util.HandleError
local SanitizeColor      = Util.SanitizeColor

H.Arsenal = H.Arsenal or {}
local A = H.Arsenal
A._Loaded = true

A.Settings = A.Settings or {
    -- Name tags
    NameTagsEnabled       = false,
    NameTagsSize          = 9,
    NameTagsColor         = Color3.fromRGB(255, 255, 255),
    NameTagsTeamCheck     = true,
    NameTagsAliveCheck    = true,

    -- Hitbox Expander (OP Silent Aim)
    HitboxExpanderEnabled     = false,
    HitboxExpanderSize        = 13,
    HitboxExpanderTransparency= 1,
    HitboxExpanderTeamCheck   = true,

    -- Weapon mods
    InfAmmoEnabled        = false,
    FireRateEnabled       = false,
    FireRateValue         = 0.02,
    RecoilEnabled         = false,
}
A.Internal = A.Internal or {
    NameTags         = {},   -- [player] = BillboardGui
    HitboxOriginals  = {},   -- [part]   = {Size, CanCollide, Transparency}
    HitboxApplied    = {},   -- [player] = {parts...}
    Conns            = {},
    WeaponLoopActive = false,
}
A.Functions = A.Functions or {}

-- ===== Shared helpers =====
local function IsAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function IsEnemy(plr)
    if plr == LocalPlayer then return false end
    local lt, tt = LocalPlayer.Team, plr.Team
    if lt and tt and lt == tt then return false end
    return true
end

-- ============================================================================
--  NAME TAGS
-- ============================================================================
local function BuildNameTag(plr)
    if plr == LocalPlayer then return end
    if not plr.Character then return end
    local head = plr.Character:FindFirstChild("Head")
    if not head then return end

    local gui = Instance.new("BillboardGui")
    gui.Name           = "AirHub_Arsenal_NameTag"
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.AlwaysOnTop    = true
    gui.LightInfluence = 1
    gui.Size           = UDim2.new(0, 300, 0, 30)
    gui.StudsOffset    = Vector3.new(0, 3, 0)
    gui.Parent         = head

    local label = Instance.new("TextLabel")
    label.Name                   = "NameLabel"
    label.BackgroundTransparency = 1
    label.Size                   = UDim2.new(1, 0, 1, 0)
    label.Font                   = Enum.Font.Ubuntu
    label.Text                   = plr.Name
    label.TextColor3             = A.Settings.NameTagsColor
    label.TextSize               = A.Settings.NameTagsSize
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
    label.TextTransparency       = 1
    label.Parent                 = gui

    A.Internal.NameTags[plr] = gui
end

local function RemoveNameTag(plr)
    local gui = A.Internal.NameTags[plr]
    if gui and gui.Parent then
        pcall(function() gui:Destroy() end)
    end
    A.Internal.NameTags[plr] = nil
end

local function RefreshNameTagVisibility(plr)
    local gui = A.Internal.NameTags[plr]
    if not gui or not gui.Parent then return end
    local label = gui:FindFirstChild("NameLabel")
    if not label then return end

    local visible = A.Settings.NameTagsEnabled
    if visible and A.Settings.NameTagsAliveCheck then
        visible = IsAlive(plr.Character)
    end
    if visible and A.Settings.NameTagsTeamCheck then
        visible = IsEnemy(plr)
    end
    label.TextTransparency = visible and 0 or 1
    label.TextSize         = A.Settings.NameTagsSize
    label.TextColor3       = A.Settings.NameTagsColor
end

local function StartNameTags()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then BuildNameTag(plr) end
    end
    if not A.Internal.Conns.nameTagStep then
        A.Internal.Conns.nameTagStep = RunService.RenderStepped:Connect(function()
            if H.ShuttingDown then return end
            if not A.Settings.NameTagsEnabled then return end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local head = plr.Character:FindFirstChild("Head")
                    if head then
                        local gui = A.Internal.NameTags[plr]
                        if not gui or not gui.Parent then
                            BuildNameTag(plr)
                        end
                        RefreshNameTagVisibility(plr)
                    end
                end
            end
        end)
    end
end

local function StopNameTags()
    for plr in pairs(A.Internal.NameTags) do
        RemoveNameTag(plr)
    end
    if A.Internal.Conns.nameTagStep then
        pcall(function() A.Internal.Conns.nameTagStep:Disconnect() end)
        A.Internal.Conns.nameTagStep = nil
    end
end

-- ============================================================================
--  HITBOX EXPANDER (OP Silent Aim)
--  Enlarges enemy limbs client-side so the server-side hit detection still
--  registers a hit when your bullet's raycast passes through the enlarged
--  hitbox. Same trick as "OP Silent Aim" — no hooking, no remote spoofing.
-- ============================================================================
local HITBOX_PARTS = {
    "RightUpperLeg", "LeftUpperLeg",
    "HeadHB", "Head",
    "HumanoidRootPart",
}

local function ApplyHitboxToPlayer(plr)
    if plr == LocalPlayer then return end
    if A.Settings.HitboxExpanderTeamCheck and not IsEnemy(plr) then return end
    local char = plr.Character
    if not char then return end

    local parts = {}
    local size = Vector3.new(
        A.Settings.HitboxExpanderSize,
        A.Settings.HitboxExpanderSize,
        A.Settings.HitboxExpanderSize
    )
    for _, name in ipairs(HITBOX_PARTS) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then
            if not A.Internal.HitboxOriginals[p] then
                A.Internal.HitboxOriginals[p] = {
                    Size         = p.Size,
                    CanCollide   = p.CanCollide,
                    Transparency = p.Transparency,
                }
            end
            pcall(function()
                p.CanCollide   = false
                p.Transparency = A.Settings.HitboxExpanderTransparency
                p.Size         = size
            end)
            parts[#parts + 1] = p
        end
    end
    A.Internal.HitboxApplied[plr] = parts
end

local function RestoreHitboxForPlayer(plr)
    local parts = A.Internal.HitboxApplied[plr]
    if not parts then return end
    for _, p in ipairs(parts) do
        local orig = A.Internal.HitboxOriginals[p]
        if orig and p.Parent then
            pcall(function()
                p.Size         = orig.Size
                p.CanCollide   = orig.CanCollide
                p.Transparency = orig.Transparency
            end)
        end
        A.Internal.HitboxOriginals[p] = nil
    end
    A.Internal.HitboxApplied[plr] = nil
end

local function StartHitboxExpander()
    for _, plr in ipairs(Players:GetPlayers()) do
        ApplyHitboxToPlayer(plr)
    end
    if not A.Internal.Conns.hitboxStep then
        A.Internal.Conns.hitboxStep = RunService.Heartbeat:Connect(function()
            if H.ShuttingDown then return end
            if not A.Settings.HitboxExpanderEnabled then return end
            local size = Vector3.new(
                A.Settings.HitboxExpanderSize,
                A.Settings.HitboxExpanderSize,
                A.Settings.HitboxExpanderSize
            )
            for plr, parts in pairs(A.Internal.HitboxApplied) do
                if not plr.Parent or not plr.Character then
                    RestoreHitboxForPlayer(plr)
                elseif A.Settings.HitboxExpanderTeamCheck and not IsEnemy(plr) then
                    --// Перестал быть врагом — снимаем хитбокс
                    RestoreHitboxForPlayer(plr)
                else
                    for _, p in ipairs(parts) do
                        if p.Parent and p.Size ~= size then
                            pcall(function()
                                p.Size         = size
                                p.CanCollide   = false
                                p.Transparency = A.Settings.HitboxExpanderTransparency
                            end)
                        end
                    end
                end
            end
            --// Discovery: подхватываем новых игроков / респавны
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and not A.Internal.HitboxApplied[plr] then
                    if not A.Settings.HitboxExpanderTeamCheck or IsEnemy(plr) then
                        ApplyHitboxToPlayer(plr)
                    end
                end
            end
        end)
    end
end

local function StopHitboxExpander()
    for plr in pairs(A.Internal.HitboxApplied) do
        RestoreHitboxForPlayer(plr)
    end
    if A.Internal.Conns.hitboxStep then
        pcall(function() A.Internal.Conns.hitboxStep:Disconnect() end)
        A.Internal.Conns.hitboxStep = nil
    end
end

-- ============================================================================
--  WEAPON MODS
-- ============================================================================
local function ApplyWeaponMods()
    pcall(function()
        if A.Settings.InfAmmoEnabled then
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local gui = pg and pg:FindFirstChild("GUI")
            local client = gui and gui:FindFirstChild("Client")
            local vars = client and client:FindFirstChild("Variables")
            if vars then
                local a1 = vars:FindFirstChild("ammocount")
                local a2 = vars:FindFirstChild("ammocount2")
                if a1 then a1.Value = 999 end
                if a2 then a2.Value = 999 end
            end
        end
        if A.Settings.FireRateEnabled or A.Settings.RecoilEnabled then
            local weapons = ReplicatedStorage:FindFirstChild("Weapons")
            if weapons then
                for _, v in ipairs(weapons:GetDescendants()) do
                    if A.Settings.FireRateEnabled then
                        if v.Name == "Auto"     then v.Value = true end
                        if v.Name == "FireRate" then v.Value = A.Settings.FireRateValue end
                    end
                    if A.Settings.RecoilEnabled then
                        if v.Name == "RecoilControl" then v.Value = 0 end
                        if v.Name == "MaxSpread"     then v.Value = 0 end
                    end
                end
            end
        end
    end)
end

local function StartWeaponMods()
    if A.Internal.WeaponLoopActive then return end
    A.Internal.WeaponLoopActive = true
    task.spawn(function()
        while A.Internal.WeaponLoopActive and not H.ShuttingDown do
            if A.Settings.InfAmmoEnabled
               or A.Settings.FireRateEnabled
               or A.Settings.RecoilEnabled then
                ApplyWeaponMods()
            end
            task.wait(0.2)
        end
    end)
end

local function StopWeaponMods()
    A.Internal.WeaponLoopActive = false
end

-- ============================================================================
--  EVENTS
-- ============================================================================
Track(Players.PlayerAdded:Connect(function(plr)
    if A.Settings.NameTagsEnabled then
        task.wait(0.5)
        if H.ShuttingDown then return end
        BuildNameTag(plr)
    end
    if A.Settings.HitboxExpanderEnabled then
        task.wait(0.5)
        if H.ShuttingDown then return end
        ApplyHitboxToPlayer(plr)
    end
end))

Track(Players.PlayerRemoving:Connect(function(plr)
    RemoveNameTag(plr)
    RestoreHitboxForPlayer(plr)
end))

Track(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if H.ShuttingDown then return end
    if A.Settings.NameTagsEnabled then
        for plr in pairs(A.Internal.NameTags) do
            if plr ~= LocalPlayer then BuildNameTag(plr) end
        end
    end
    if A.Settings.HitboxExpanderEnabled then
        StartHitboxExpander()
    end
end))

-- ============================================================================
--  UI
-- ============================================================================
local function FillUI()
    local MainFrame = H._UI and H._UI.MainFrame
    if not MainFrame then return false end

    local tab = MainFrame:CreateTab({ Name = "Arsenal" })

    -- Name tags
    local secNT = tab:CreateSection({ Name = "Name Tags" })
    secNT:AddToggle({ Name = "Enabled", Value = A.Settings.NameTagsEnabled,
        Callback = function(v)
            A.Settings.NameTagsEnabled = v
            if v then StartNameTags() else StopNameTags() end
        end })
    secNT:AddSlider({ Name = "Text Size", Value = A.Settings.NameTagsSize,
        Min = 6, Max = 24,
        Callback = function(v) A.Settings.NameTagsSize = v end })
    secNT:AddColorpicker({ Name = "Text Color", Value = A.Settings.NameTagsColor,
        Callback = function(v) A.Settings.NameTagsColor = SanitizeColor(v) end })
    secNT:AddToggle({ Name = "Team Check", Value = A.Settings.NameTagsTeamCheck,
        Callback = function(v) A.Settings.NameTagsTeamCheck = v end })
    secNT:AddToggle({ Name = "Alive Check", Value = A.Settings.NameTagsAliveCheck,
        Callback = function(v) A.Settings.NameTagsAliveCheck = v end })

    -- Hitbox Expander (OP Silent Aim)
    local secHB = tab:CreateSection({ Name = "Hitbox Expander (OP Silent Aim)", Side = "Right" })
    secHB:AddToggle({ Name = "Enabled", Value = A.Settings.HitboxExpanderEnabled,
        Callback = function(v)
            A.Settings.HitboxExpanderEnabled = v
            if v then StartHitboxExpander() else StopHitboxExpander() end
        end })
    secHB:AddSlider({ Name = "Hitbox Size", Value = A.Settings.HitboxExpanderSize,
        Min = 5, Max = 30,
        Callback = function(v)
            A.Settings.HitboxExpanderSize = v
            if A.Settings.HitboxExpanderEnabled then
                StopHitboxExpander(); StartHitboxExpander()
            end
        end })
    secHB:AddSlider({ Name = "Transparency", Value = A.Settings.HitboxExpanderTransparency,
        Min = 0, Max = 1, Decimals = 2,
        Callback = function(v) A.Settings.HitboxExpanderTransparency = v end })
    secHB:AddToggle({ Name = "Team Check", Value = A.Settings.HitboxExpanderTeamCheck,
        Callback = function(v)
            A.Settings.HitboxExpanderTeamCheck = v
            if A.Settings.HitboxExpanderEnabled then
                StopHitboxExpander(); StartHitboxExpander()
            end
        end })

    -- Weapon mods
    local secWM = tab:CreateSection({ Name = "Weapon Mods" })
    secWM:AddToggle({ Name = "Infinite Ammo", Value = A.Settings.InfAmmoEnabled,
        Callback = function(v)
            A.Settings.InfAmmoEnabled = v
            if v then StartWeaponMods() end
        end })
    secWM:AddToggle({ Name = "Fire Rate Mod", Value = A.Settings.FireRateEnabled,
        Callback = function(v)
            A.Settings.FireRateEnabled = v
            if v then StartWeaponMods() end
        end })
    secWM:AddSlider({ Name = "Fire Rate Value", Value = A.Settings.FireRateValue,
        Min = 0.01, Max = 0.5, Decimals = 3,
        Callback = function(v) A.Settings.FireRateValue = v end })
    secWM:AddToggle({ Name = "Recoil Mod", Value = A.Settings.RecoilEnabled,
        Callback = function(v)
            A.Settings.RecoilEnabled = v
            if v then StartWeaponMods() end
        end })

    return true
end

-- Wait for UI to be ready before adding the tab
task.spawn(function()
    local deadline = tick() + 30
    while tick() < deadline do
        if H.ShuttingDown then return end
        if H._UI and H._UI.MainFrame then break end
        task.wait(0.25)
    end
    if not H._UI or not H._UI.MainFrame then
        warn("[AirHub] 11_arsenal: MainFrame never appeared, aborting")
        return
    end
    if not FillUI() then
        warn("[AirHub] 11_arsenal: FillUI failed")
        return
    end
    print("[AirHub] 11_arsenal: loaded OK")
end)

-- ============================================================================
--  PUBLIC API / CLEANUP
-- ============================================================================
A.Functions.StopAll = function()
    A.Settings.NameTagsEnabled        = false
    A.Settings.HitboxExpanderEnabled  = false
    A.Settings.InfAmmoEnabled         = false
    A.Settings.FireRateEnabled        = false
    A.Settings.RecoilEnabled          = false
    StopNameTags()
    StopHitboxExpander()
    StopWeaponMods()
end
