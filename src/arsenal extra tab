--// ============================================================================
--// AirHub - arsenal extra tab
--// Extra tab "Quotas" — ported from the Quotas Hub standalone script.
--//
--// Features:
--//   • Name Tags ESP    — player name above head with team/alive checks
--//   • Limb Hitbox      — "OP Silent Aim" style: enlarge enemy limbs client-side
--//   • Weapon Mods      — Infinite Ammo, Fire Rate, Recoil (ReplicatedStorage.Weapons)
--//                        + Auto Reload (spam Events.empty:FireServer(true) every frame)
--//
--// Requires: 01_core.lua, 07a_ui_core.lua
--// ============================================================================

local H = getgenv().AirHub
if not H or not H._CoreLoaded then warn("[AirHub] arsenal extra tab: core not loaded") return end
if H.Quotas and H.Quotas._Loaded then return end

local Util               = H.Util
local Players            = Util.Players
local RunService         = Util.RunService
local LocalPlayer        = Util.LocalPlayer
local ReplicatedStorage  = Util.ReplicatedStorage
local Track              = Util.Track
local HandleError        = Util.HandleError
local SanitizeColor      = Util.SanitizeColor

H.Quotas = H.Quotas or {}
local Q = H.Quotas
Q._Loaded = true

Q.Settings = Q.Settings or {
    -- Name tags
    NameTagsEnabled       = false,
    NameTagsSize          = 9,
    NameTagsColor         = Color3.fromRGB(255, 255, 255),
    NameTagsTeamCheck     = true,
    NameTagsAliveCheck    = true,

    -- Limb hitbox
    LimbHitboxEnabled     = false,
    LimbHitboxSize        = 13,
    LimbHitboxTransparency= 1,
    LimbHitboxTeamCheck   = true,

    -- Weapon mods
    InfAmmoEnabled        = false,
    FireRateEnabled       = false,
    FireRateValue         = 0.02,
    RecoilEnabled         = false,
    AutoReloadEnabled     = false,   -- [NEW] spam Events.empty:FireServer(true)
}
Q.Internal = Q.Internal or {
    NameTags         = {},   -- [player] = BillboardGui
    LimbOriginals    = {},   -- [part]   = {Size, CanCollide, Transparency}
    LimbApplied      = {},   -- [player] = {parts...}
    Conns            = {},
    WeaponLoopActive = false,
    AutoReloadConn   = nil,  -- [NEW] RenderStepped connection
}
Q.Functions = Q.Functions or {}

-- ===== Shared helpers =====
local function IsAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function IsEnemy(plr)
    if plr == LocalPlayer then return false end
    local lt, tt = LocalPlayer.Team, plr.Team
    if lt and tt and lt == tt then return false end
    return true
end

-- ============================================================================
--  NAME TAGS
-- ============================================================================
local function BuildNameTag(plr)
    if plr == LocalPlayer then return end
    if not plr.Character then return end
    local head = plr.Character:FindFirstChild("Head")
    if not head then return end

    local gui = Instance.new("BillboardGui")
    gui.Name          = "AirHub_Quotas_NameTag"
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.AlwaysOnTop   = true
    gui.LightInfluence = 1
    gui.Size          = UDim2.new(0, 300, 0, 30)
    gui.StudsOffset   = Vector3.new(0, 3, 0)
    gui.Parent        = head

    local label = Instance.new("TextLabel")
    label.Name                  = "NameLabel"
    label.BackgroundTransparency = 1
    label.Size                  = UDim2.new(1, 0, 1, 0)
    label.Font                  = Enum.Font.Ubuntu
    label.Text                  = plr.Name
    label.TextColor3            = Q.Settings.NameTagsColor
    label.TextSize              = Q.Settings.NameTagsSize
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3      = Color3.fromRGB(0, 0, 0)
    label.TextTransparency      = 1
    label.Parent                = gui

    Q.Internal.NameTags[plr] = gui
end

local function RemoveNameTag(plr)
    local gui = Q.Internal.NameTags[plr]
    if gui and gui.Parent then
        pcall(function() gui:Destroy() end)
    end
    Q.Internal.NameTags[plr] = nil
end

local function RefreshNameTagVisibility(plr)
    local gui = Q.Internal.NameTags[plr]
    if not gui or not gui.Parent then return end
    local label = gui:FindFirstChild("NameLabel")
    if not label then return end

    local visible = Q.Settings.NameTagsEnabled
    if visible and Q.Settings.NameTagsAliveCheck then
        visible = IsAlive(plr.Character)
    end
    if visible and Q.Settings.NameTagsTeamCheck then
        visible = IsEnemy(plr)
    end
    label.TextTransparency = visible and 0 or 1
    label.TextSize         = Q.Settings.NameTagsSize
    label.TextColor3       = Q.Settings.NameTagsColor
end

local function StartNameTags()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then BuildNameTag(plr) end
    end
    if not Q.Internal.Conns.nameTagStep then
        Q.Internal.Conns.nameTagStep = RunService.RenderStepped:Connect(function()
            if H.ShuttingDown then return end
            if not Q.Settings.NameTagsEnabled then return end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local head = plr.Character:FindFirstChild("Head")
                    if head then
                        local gui = Q.Internal.NameTags[plr]
                        if not gui or not gui.Parent then
                            BuildNameTag(plr)
                        end
                        RefreshNameTagVisibility(plr)
                    end
                end
            end
        end)
    end
end

local function StopNameTags()
    for plr in pairs(Q.Internal.NameTags) do
        RemoveNameTag(plr)
    end
    if Q.Internal.Conns.nameTagStep then
        pcall(function() Q.Internal.Conns.nameTagStep:Disconnect() end)
        Q.Internal.Conns.nameTagStep = nil
    end
end

-- ============================================================================
--  LIMB HITBOX (OP Silent Aim)
-- ============================================================================
local LIMB_PARTS = {
    "RightUpperLeg", "LeftUpperLeg",
    "HeadHB", "Head",
    "HumanoidRootPart",
}

local function ApplyLimbHitboxForPlayer(plr)
    if plr == LocalPlayer then return end
    if Q.Settings.LimbHitboxTeamCheck and not IsEnemy(plr) then return end
    local char = plr.Character
    if not char then return end

    local parts = {}
    local size = Vector3.new(Q.Settings.LimbHitboxSize, Q.Settings.LimbHitboxSize, Q.Settings.LimbHitboxSize)
    for _, name in ipairs(LIMB_PARTS) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then
            if not Q.Internal.LimbOriginals[p] then
                Q.Internal.LimbOriginals[p] = {
                    Size         = p.Size,
                    CanCollide   = p.CanCollide,
                    Transparency = p.Transparency,
                }
            end
            pcall(function()
                p.CanCollide   = false
                p.Transparency = Q.Settings.LimbHitboxTransparency
                p.Size         = size
            end)
            parts[#parts + 1] = p
        end
    end
    Q.Internal.LimbApplied[plr] = parts
end

local function RestoreLimbHitboxForPlayer(plr)
    local parts = Q.Internal.LimbApplied[plr]
    if not parts then return end
    for _, p in ipairs(parts) do
        local orig = Q.Internal.LimbOriginals[p]
        if orig and p.Parent then
            pcall(function()
                p.Size         = orig.Size
                p.CanCollide   = orig.CanCollide
                p.Transparency = orig.Transparency
            end)
        end
        Q.Internal.LimbOriginals[p] = nil
    end
    Q.Internal.LimbApplied[plr] = nil
end

local function StartLimbHitbox()
    for _, plr in ipairs(Players:GetPlayers()) do
        ApplyLimbHitboxForPlayer(plr)
    end
    if not Q.Internal.Conns.limbStep then
        Q.Internal.Conns.limbStep = RunService.Heartbeat:Connect(function()
            if H.ShuttingDown then return end
            if not Q.Settings.LimbHitboxEnabled then return end
            local size = Vector3.new(Q.Settings.LimbHitboxSize, Q.Settings.LimbHitboxSize, Q.Settings.LimbHitboxSize)
            for plr, parts in pairs(Q.Internal.LimbApplied) do
                if not plr.Parent or not plr.Character then
                    RestoreLimbHitboxForPlayer(plr)
                else
                    for _, p in ipairs(parts) do
                        if p.Parent and p.Size ~= size then
                            pcall(function()
                                p.Size         = size
                                p.CanCollide   = false
                                p.Transparency = Q.Settings.LimbHitboxTransparency
                            end)
                        end
                    end
                end
            end
        end)
    end
end

local function StopLimbHitbox()
    for plr in pairs(Q.Internal.LimbApplied) do
        RestoreLimbHitboxForPlayer(plr)
    end
    if Q.Internal.Conns.limbStep then
        pcall(function() Q.Internal.Conns.limbStep:Disconnect() end)
        Q.Internal.Conns.limbStep = nil
    end
end

-- ============================================================================
--  WEAPON MODS
-- ============================================================================
local function ApplyWeaponMods()
    pcall(function()
        if Q.Settings.InfAmmoEnabled then
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local gui = pg and pg:FindFirstChild("GUI")
            local client = gui and gui:FindFirstChild("Client")
            local vars = client and client:FindFirstChild("Variables")
            if vars then
                local a1 = vars:FindFirstChild("ammocount")
                local a2 = vars:FindFirstChild("ammocount2")
                if a1 then a1.Value = 999 end
                if a2 then a2.Value = 999 end
            end
        end
        if Q.Settings.FireRateEnabled or Q.Settings.RecoilEnabled then
            local weapons = ReplicatedStorage:FindFirstChild("Weapons")
            if weapons then
                for _, v in ipairs(weapons:GetDescendants()) do
                    if Q.Settings.FireRateEnabled then
                        if v.Name == "Auto"     then v.Value = true end
                        if v.Name == "FireRate" then v.Value = Q.Settings.FireRateValue end
                    end
                    if Q.Settings.RecoilEnabled then
                        if v.Name == "RecoilControl" then v.Value = 0 end
                        if v.Name == "MaxSpread"     then v.Value = 0 end
                    end
                end
            end
        end
    end)
end

local function StartWeaponMods()
    if Q.Internal.WeaponLoopActive then return end
    Q.Internal.WeaponLoopActive = true
    task.spawn(function()
        while Q.Internal.WeaponLoopActive and not H.ShuttingDown do
            if Q.Settings.InfAmmoEnabled
               or Q.Settings.FireRateEnabled
               or Q.Settings.RecoilEnabled then
                ApplyWeaponMods()
            end
            task.wait(0.2)
        end
    end)
end

local function StopWeaponMods()
    Q.Internal.WeaponLoopActive = false
end

-- ============================================================================
--  AUTO RELOAD  — spam Events.empty:FireServer(true) every frame
-- ============================================================================

--// Универсальная добыча remote'а: сначала пробуем кэш, потом
--// ReplicatedStorage.Events.empty. Возвращает nil если события ещё нет.
local function GetAutoReloadRemote()
    local events = ReplicatedStorage:FindFirstChild("Events")
    if not events then return nil end
    local empty = events:FindFirstChild("empty")
    if not empty then return nil end
    if not empty:IsA("RemoteEvent") and not empty:IsA("UnreliableRemoteEvent") then
        return nil
    end
    return empty
end

local function StartAutoReload()
    if Q.Internal.AutoReloadConn then return end

    --// RenderStepped = "каждый кадр". pcall вокруг FireServer — на случай,
    --// если remote пересоздаётся между раундами.
    Q.Internal.AutoReloadConn = RunService.RenderStepped:Connect(function()
        if H.ShuttingDown then return end
        if not Q.Settings.AutoReloadEnabled then return end
        local remote = GetAutoReloadRemote()
        if not remote then return end
        pcall(function() remote:FireServer(true) end)
    end)
end

local function StopAutoReload()
    if Q.Internal.AutoReloadConn then
        pcall(function() Q.Internal.AutoReloadConn:Disconnect() end)
        Q.Internal.AutoReloadConn = nil
    end
end

-- ============================================================================
--  EVENTS
-- ============================================================================
Track(Players.PlayerAdded:Connect(function(plr)
    if Q.Settings.NameTagsEnabled then
        task.wait(0.5)
        if H.ShuttingDown then return end
        BuildNameTag(plr)
    end
end))

Track(Players.PlayerRemoving:Connect(function(plr)
    RemoveNameTag(plr)
    RestoreLimbHitboxForPlayer(plr)
end))

Track(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if H.ShuttingDown then return end
    if Q.Settings.NameTagsEnabled then
        for plr in pairs(Q.Internal.NameTags) do
            if plr ~= LocalPlayer then BuildNameTag(plr) end
        end
    end
end))

-- ============================================================================
--  UI
-- ============================================================================
local function FillUI()
    local MainFrame = H._UI and H._UI.MainFrame
    if not MainFrame then return false end

    local tab = MainFrame:CreateTab({ Name = "Quotas" })

    -- Name tags
    local secNT = tab:CreateSection({ Name = "Name Tags" })
    secNT:AddToggle({ Name = "Enabled", Value = Q.Settings.NameTagsEnabled,
        Callback = function(v)
            Q.Settings.NameTagsEnabled = v
            if v then StartNameTags() else StopNameTags() end
        end })
    secNT:AddSlider({ Name = "Text Size", Value = Q.Settings.NameTagsSize,
        Min = 6, Max = 24,
        Callback = function(v) Q.Settings.NameTagsSize = v end })
    secNT:AddColorpicker({ Name = "Text Color", Value = Q.Settings.NameTagsColor,
        Callback = function(v) Q.Settings.NameTagsColor = SanitizeColor(v) end })
    secNT:AddToggle({ Name = "Team Check", Value = Q.Settings.NameTagsTeamCheck,
        Callback = function(v) Q.Settings.NameTagsTeamCheck = v end })
    secNT:AddToggle({ Name = "Alive Check", Value = Q.Settings.NameTagsAliveCheck,
        Callback = function(v) Q.Settings.NameTagsAliveCheck = v end })

    -- Limb hitbox
    local secLH = tab:CreateSection({ Name = "Limb Hitbox (OP Silent Aim)", Side = "Right" })
    secLH:AddToggle({ Name = "Enabled", Value = Q.Settings.LimbHitboxEnabled,
        Callback = function(v)
            Q.Settings.LimbHitboxEnabled = v
            if v then StartLimbHitbox() else StopLimbHitbox() end
        end })
    secLH:AddSlider({ Name = "Hitbox Size", Value = Q.Settings.LimbHitboxSize,
        Min = 5, Max = 30,
        Callback = function(v)
            Q.Settings.LimbHitboxSize = v
            if Q.Settings.LimbHitboxEnabled then
                StopLimbHitbox(); StartLimbHitbox()
            end
        end })
    secLH:AddSlider({ Name = "Transparency", Value = Q.Settings.LimbHitboxTransparency,
        Min = 0, Max = 1, Decimals = 2,
        Callback = function(v) Q.Settings.LimbHitboxTransparency = v end })
    secLH:AddToggle({ Name = "Team Check", Value = Q.Settings.LimbHitboxTeamCheck,
        Callback = function(v)
            Q.Settings.LimbHitboxTeamCheck = v
            if Q.Settings.LimbHitboxEnabled then
                StopLimbHitbox(); StartLimbHitbox()
            end
        end })

    -- Weapon mods
    local secWM = tab:CreateSection({ Name = "Weapon Mods" })
    secWM:AddToggle({ Name = "Infinite Ammo", Value = Q.Settings.InfAmmoEnabled,
        Callback = function(v)
            Q.Settings.InfAmmoEnabled = v
            if v then StartWeaponMods() end
        end })
    secWM:AddToggle({ Name = "Fire Rate Mod", Value = Q.Settings.FireRateEnabled,
        Callback = function(v)
            Q.Settings.FireRateEnabled = v
            if v then StartWeaponMods() end
        end })
    secWM:AddSlider({ Name = "Fire Rate Value", Value = Q.Settings.FireRateValue,
        Min = 0.01, Max = 0.5, Decimals = 3,
        Callback = function(v) Q.Settings.FireRateValue = v end })
    secWM:AddToggle({ Name = "Recoil Mod", Value = Q.Settings.RecoilEnabled,
        Callback = function(v)
            Q.Settings.RecoilEnabled = v
            if v then StartWeaponMods() end
        end })

    -- [NEW] Auto Reload
    secWM:AddToggle({ Name = "Auto Reload (spam every frame)", Value = Q.Settings.AutoReloadEnabled,
        Callback = function(v)
            Q.Settings.AutoReloadEnabled = v
            if v then StartAutoReload() else StopAutoReload() end
        end })

    return true
end

-- Wait for UI to be ready before adding the tab
task.spawn(function()
    local deadline = tick() + 30
    while tick() < deadline do
        if H.ShuttingDown then return end
        if H._UI and H._UI.MainFrame then break end
        task.wait(0.25)
    end
    if not H._UI or not H._UI.MainFrame then
        warn("[AirHub] arsenal extra tab: MainFrame never appeared, aborting")
        return
    end
    if not FillUI() then
        warn("[AirHub] arsenal extra tab: FillUI failed")
        return
    end
    print("[AirHub] arsenal extra tab: loaded OK")
end)

-- ============================================================================
--  PUBLIC API / CLEANUP
-- ============================================================================
Q.Functions.StopAll = function()
    Q.Settings.NameTagsEnabled    = false
    Q.Settings.LimbHitboxEnabled  = false
    Q.Settings.InfAmmoEnabled     = false
    Q.Settings.FireRateEnabled    = false
    Q.Settings.RecoilEnabled      = false
    Q.Settings.AutoReloadEnabled  = false    -- [NEW]
    StopNameTags()
    StopLimbHitbox()
    StopWeaponMods()
    StopAutoReload()                         -- [NEW]
end

Q.Functions.GetAutoReloadRemote = GetAutoReloadRemote
