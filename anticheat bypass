--=============================================================
-- 2. AUTO-BYPASS RUNNER
--=============================================================
local function autoBypass()
    SECTION("STEP 2 / 3  —  Auto-Bypass")

    local ok_count, fail_count = 0, 0
    local total = #steps

    for i, step in ipairs(steps) do
        local ok, result = safe(step.fn)
        if ok then
            ok_count += 1
            OK(string.format("[%02d/%02d] %s", i, total, step.name), result)
        else
            fail_count += 1
            FAIL(string.format("[%02d/%02d] %s", i, total, step.name), result)
        end
        task.wait(CONFIG.STEP_WAIT)
    end

    L(string.format("  →  %d succeeded / %d failed  (of %d)", ok_count, fail_count, total))
    return ok_count, fail_count
end

--=============================================================
-- 3. AIRHUB LOADER
--=============================================================
local function fetchUrl(url)
    if type(game.HttpGet) == "function" then
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if ok and type(body) == "string" and body ~= "" then return body end
    end
    if type(game.HttpGetAsync) == "function" then
        local ok, body = pcall(function() return game:HttpGetAsync(url) end)
        if ok and type(body) == "string" and body ~= "" then return body end
    end
    local httpGet = getExec("httpget") or getExec("HttpGet")
    if httpGet then
        local ok, body = pcall(httpGet, url)
        if ok and type(body) == "string" and body ~= "" then return body end
    end
    local request = getExec("request") or getExec("http_request")
    if request then
        local ok, res = pcall(request, { Url = url, Method = "GET" })
        if ok and type(res) == "table" and type(res.Body) == "string" then
            return res.Body
        end
    end
    return nil
end

local function compileLua(source)
    if type(source) ~= "string" or source == "" then return nil, "empty source" end

    local head = source:sub(1, 200):lower()
    if head:find("<!doctype html") or head:find("<html") then
        return nil, "response is HTML (private repo / 404 / wrong path)"
    end

    if type(loadstring) == "function" then
        local ok, fn, err = pcall(loadstring, source)
        if ok and fn then return fn end
        if err then return nil, "loadstring: " .. tostring(err) end
    end
    if type(load) == "function" then
        local ok, fn, err = pcall(load, source, "=AirHub")
        if ok and fn then return fn end
        if err then return nil, "load: " .. tostring(err) end
    end
    return nil, "no loadstring/load available"
end

local function injectAirHub()
    SECTION("STEP 3 / 3  —  Inject AirHub")

    local source = CONFIG.AIRHUB_SOURCE
    local origin = "inline source"
    local url    = CONFIG.AIRHUB_URL

    if not source then
        if not url or url == "" then
            FAIL("AirHub", "no URL or SOURCE configured")
            return false
        end

        L("  ↓  Fetching: " .. url)
        local t0 = tick()
        source = fetchUrl(url)
        local dt = tick() - t0

        if not source then
            FAIL("AirHub fetch", "request failed (no response)")
            return false
        end
        OK("Downloaded", string.format("%d bytes in %.2fs", #source, dt))
        origin = url
    else
        OK("Using inline source", string.format("%d bytes", #source))
    end

    local fn, err = compileLua(source)
    if not fn then
        FAIL("Compile", err)
        return false
    end
    OK("Compiled", "OK")

    local ok, runErr = pcall(fn)
    if not ok then
        FAIL("Execute", tostring(runErr))
        return false
    end

    OK("Executed", "loaded from " .. origin)
    return true
end

--=============================================================
-- MAIN
--=============================================================
task.spawn(function()
    L("═════════════════════════════════════════")
    L("  AutoDetect → AutoBypass → AirHub")
    L("═════════════════════════════════════════")

    local t_start = tick()

    -- 1) Detect
    autoDetect()

    -- 2) Bypass
    autoBypass()

    -- 3) Inject
    task.wait(0.2)
    local injected = injectAirHub()

    local total_time = tick() - t_start
    L("═════════════════════════════════════════")
    if injected then
        L(string.format("  DONE  ✓   total %.2fs", total_time))
    else
        L(string.format("  FAILED  ✗   total %.2fs", total_time))
    end
    L("═════════════════════════════════════════")
end)
