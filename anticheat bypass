makeButton("▶ Auto Bypass + Load AirHub", function()
    task.spawn(function()
        runAutoBypass(false)
        setStatus("Loading AirHub...", Color3.fromRGB(255, 165, 0))
        task.wait(CONFIG.AIRHUB_WAIT)
        local ok, msg = loadAirHub()
        if ok then
            setStatus("AirHub loaded ✓", Color3.fromRGB(0, 255, 0))
            notify("AirHub", "Injected successfully", 5)
        else
            setStatus("AirHub failed: " .. tostring(msg), Color3.fromRGB(255, 80, 80))
            notify("AirHub Failed", tostring(msg), 8)
            warn("[RainbowEdge] AirHub failed: " .. tostring(msg))
        end
    end)
end)

makeButton("↻ Reload AirHub (bypass already done)", function()
