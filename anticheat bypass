--=============================================================
-- STARTUP SEQUENCE
--   1) silent bypass
--   2) показать GUI
--   3) загрузить AirHub по URL
--=============================================================
task.spawn(function()
    -- 1) Auto-bypass (молча)
    if CONFIG.AUTO_BYPASS_ON_LOAD then
        local ok, res = pcall(runAutoBypass, true)
        if not ok then
            warn("[RainbowEdge] auto-bypass crashed: " .. tostring(res))
        elseif type(res) == "table" then
            warn(("[RainbowEdge] auto-bypass: %d ok / %d fail")
                  :format(res.ok or 0, res.fail or 0))
        end
    end

    -- 2) Показать GUI
    if CONFIG.SHOW_BYPASS_GUI then
        RainbowEdgeGui.Enabled = true
        setStatus("Ready — Bypass done", Color3.fromRGB(0, 255, 0))
    end

    -- 3) AirHub по URL
    task.wait(CONFIG.AIRHUB_WAIT)
    setStatus("Loading AirHub...", Color3.fromRGB(255, 165, 0))
    local ok, msg = loadAirHub()
    if ok then
        setStatus("AirHub loaded ✓", Color3.fromRGB(0, 255, 0))
        notify("AirHub", "Injected successfully", 5)
    else
        setStatus("AirHub failed: " .. tostring(msg), Color3.fromRGB(255, 80, 80))
        notify("AirHub Failed", tostring(msg), 8)
        warn("[RainbowEdge] AirHub failed: " .. tostring(msg))
    end
end)

RainbowEdgeGui.Destroying:Connect(function()
    rainbowRunning = false
end)
