--=============================================================
-- LOGGING  (чистый вывод в консоль)
--=============================================================
local LOG_PREFIX = "[Bypass]"

local function L(msg)
    warn(LOG_PREFIX .. " " .. tostring(msg))
end

local function OK(label, extra)
    local line = "  ✓  " .. label
    if extra then line = line .. "  (" .. tostring(extra) .. ")" end
    warn(LOG_PREFIX .. line)
end

local function FAIL(label, reason)
    warn(LOG_PREFIX .. "  ✗  " .. label .. "  →  " .. tostring(reason))
end

local function SECTION(title)
    warn(LOG_PREFIX .. "─────────────────────────────────────────")
    warn(LOG_PREFIX .. "  " .. title)
end

--=============================================================
-- ENV HELPERS
--=============================================================
local function E()
    if type(getgenv) == "function" then
        local ok, env = pcall(getgenv)
        if ok and type(env) == "table" then return env end
    end
    return _G
end

local function getExec(name)
    local f = rawget(_G, name)
    if type(f) == "function" then return f end
    local env = E()
    if env and env ~= _G then
        f = rawget(env, name)
        if type(f) == "function" then return f end
    end
    return nil
end

local function hasExec(name) return getExec(name) ~= nil end

local function safe(fn, ...)
    local r = table.pack(pcall(fn, ...))
    if not r[1] then return false, r[2] end
    return true, table.unpack(r, 2, r.n)
end

--=============================================================
-- 1. AUTO-DETECT
--=============================================================
local DETECT_GROUPS = {
    ["Core"] = {
        "getgenv", "getrenv", "getreg", "getgc",
        "getrawmetatable", "setrawmetatable",
        "setreadonly", "isreadonly",
    },
    ["Meta"] = {
        "hookmetamethod", "getnamecallmethod",
        "hookfunction", "newcclosure", "checkcaller",
    },
    ["Reflect"] = {
        "getupvalues", "setupvalue", "getupvalue", "setupvalue",
        "getconstants", "getinfo", "getproto",
    },
    ["Script"] = {
        "getcallingscript", "getscriptclosure", "getloadedmodules",
        "getscripts", "getnilinstances", "getconnections",
    },
    ["Input"] = {
        "firetouchinterest", "fireclickdetector", "fireproximityprompt",
    },
    ["HTTP"] = {
        "httpget", "HttpGet", "request", "http_request", "syn",
    },
}

local function autoDetect()
    SECTION("STEP 1 / 3  —  Auto-Detect")

    local total = 0
    local found = 0
    local available = {}

    for group, names in pairs(DETECT_GROUPS) do
        local foundInGroup = {}
        for _, name in ipairs(names) do
            total += 1
            if hasExec(name) then
                found += 1
                table.insert(foundInGroup, name)
                available[name] = true
            end
        end
        if #foundInGroup > 0 then
            OK(group, table.concat(foundInGroup, ", "))
        else
            FAIL(group, "nothing available")
        end
    end

    -- Особые проверки
    local extras = {}
    if type(loadstring) == "function" then
        extras[#extras + 1] = "loadstring"
        available.loadstring = true
    end
    if type(load) == "function" then
        extras[#extras + 1] = "load"
    end
    if type(debug) == "table" then
        extras[#extras + 1] = "debug"
        available.debug = true
    end
    if type(coroutine) == "table" then
        extras[#extras + 1] = "coroutine"
    end
    if #extras > 0 then
        OK("Lua stdlib", table.concat(extras, ", "))
    end

    L(string.format("  →  %d / %d executor functions detected", found, total))
    return found, total, available
end

--=============================================================
-- NAMECALL MANAGER
--=============================================================
local NamecallManager = { hooked = false, filters = {} }

local function NM_Ensure()
    if NamecallManager.hooked then return true end
    local hook      = getExec("hookmetamethod")
    local getMethod = getExec("getnamecallmethod")
    if not hook or not getMethod then return false end

    local ok = pcall(function()
        local old
        local wrapper = function(self, ...)
            local method = getMethod()
            if type(method) == "string" then
                local handlers = NamecallManager.filters[method]
                if handlers then
                    for _, handler in ipairs(handlers) do
                        local hOk, result = pcall(handler, self, ...)
                        if hOk and result == "block" then return end
                    end
                end
            end
            return old(self, ...)
        end
        local newc = getExec("newcclosure")
        if newc then pcall(function() wrapper = newc(wrapper) end) end
        old = hook(game, "__namecall", wrapper)
    end)

    if ok then NamecallManager.hooked = true end
    return NamecallManager.hooked
end

local function NM_Register(method, handler)
    if not NamecallManager.filters[method] then
        NamecallManager.filters[method] = {}
    end
    table.insert(NamecallManager.filters[method], handler)
end

